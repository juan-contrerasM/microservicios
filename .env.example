# Copiar a .env (nunca commitear .env real) antes de `docker compose up --build`.
# docker compose lee automáticamente un archivo .env en la raíz del proyecto.

# --- api-gateway: ÚNICO puerto publicado al host (Reto 3) ---
GATEWAY_PORT=8080
# Debe superar el peor caso del cliente empleados → departamentos:
# 4 timeouts de 5s + backoff 1s+2s+4s = ~27s.
PROXY_TIMEOUT_MS=35000

# --- empleados-service (Java) + database-empleados (PostgreSQL) ---
# El servicio ya no publica puerto al host (expose: 8080 interno).
EMPLEADOS_DB_NAME=hr_management
EMPLEADOS_DB_USER=empleados
EMPLEADOS_DB_PASSWORD=empleados
# Política del cliente HTTP empleados -> departamentos.
DEPARTAMENTOS_SERVICE_TIMEOUT=5s
# Incluye el intento inicial: 4 intentos producen esperas de 1s, 2s y 4s.
DEPARTAMENTOS_SERVICE_MAX_ATTEMPTS=4
DEPARTAMENTOS_SERVICE_INITIAL_BACKOFF=1s
# Circuit Breaker (Resilience4j) sobre esa misma llamada (Reto 3, Etapa 3).
CB_SLIDING_WINDOW_SIZE=3
CB_MINIMUM_NUMBER_OF_CALLS=3
CB_FAILURE_RATE_THRESHOLD=100
CB_WAIT_DURATION_OPEN=30s
CB_PERMITTED_CALLS_HALF_OPEN=1

# --- departamentos-service (Go) + database-departamentos (MySQL) ---
# El servicio ya no publica puerto al host (expose: 8081 interno).
DEPARTAMENTOS_DB_NAME=departamentos_db
DEPARTAMENTOS_DB_USER=departamentos
DEPARTAMENTOS_DB_PASSWORD=departamentos
# Contraseña de administración exigida por la imagen oficial de MySQL.
DEPARTAMENTOS_DB_ROOT_PASSWORD=departamentos_root

# --- message-broker (RabbitMQ 3 management) ---
# Infraestructura: 5672 es AMQP, 15672 es la UI. El único puerto de negocio sigue siendo 8080.
# Los servicios, cuando existan, hablan por message-broker:5672 dentro de la red.
# RABBITMQ_DEFAULT_USER/PASS solo se aplican la primera vez que se crea el volumen.
RABBITMQ_USER=onboarding
RABBITMQ_PASSWORD=onboarding
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Exchange topic que declara empleados-service al arrancar. La routing key es el type del evento.
# BROKER_URL no va aquí: el compose la fija en amqp://message-broker:5672 (red interna).
BROKER_EXCHANGE=onboarding.eventos

# --- notificaciones-service (Python) + database-notificaciones (PostgreSQL) ---
# Puerto interno 8084, sin publicar al host. Se alcanza por http://localhost:8080/notificaciones
NOTIFICACIONES_DB_NAME=notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones
NOTIFICACIONES_DB_PASSWORD=notificaciones

# --- perfiles-service (Java) + database-perfiles (PostgreSQL) ---
# Puerto interno 8083, sin publicar al host. Se alcanza por http://localhost:8080/perfiles
PERFILES_DB_NAME=perfiles_db
PERFILES_DB_USER=perfiles
PERFILES_DB_PASSWORD=perfiles

# --- vacaciones-service (Node.js) + database-vacaciones (PostgreSQL) ---
# Puerto interno 8085, sin publicar al host. Se alcanza por http://localhost:8080/vacaciones
VACACIONES_DB_NAME=vacaciones_db
VACACIONES_DB_USER=vacaciones
VACACIONES_DB_PASSWORD=vacaciones

# --- Correo de desarrollo (Mailhog). La bandeja se abre en el host. ---
SMTP_FROM=onboarding@empresa.com
MAILHOG_UI_PORT=8025
