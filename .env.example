# Copiar a .env (nunca commitear .env real) antes de `docker compose up --build`.
# docker compose lee automáticamente un archivo .env en la raíz del proyecto.

# --- api-gateway: ÚNICO puerto publicado al host (Reto 3) ---
GATEWAY_PORT=8080

# --- empleados-service (Java) + database-empleados (PostgreSQL) ---
# El servicio ya no publica puerto al host (expose: 8080 interno).
EMPLEADOS_DB_NAME=hr_management
EMPLEADOS_DB_USER=empleados
EMPLEADOS_DB_PASSWORD=empleados
# Política del cliente HTTP empleados -> departamentos.
DEPARTAMENTOS_SERVICE_TIMEOUT=3s
# Incluye el intento inicial: 4 intentos producen esperas de 1s, 2s y 4s.
DEPARTAMENTOS_SERVICE_MAX_ATTEMPTS=4
DEPARTAMENTOS_SERVICE_INITIAL_BACKOFF=1s

# --- departamentos-service (Go) + database-departamentos (MySQL) ---
# El servicio ya no publica puerto al host (expose: 8081 interno).
DEPARTAMENTOS_DB_NAME=departamentos_db
DEPARTAMENTOS_DB_USER=departamentos
DEPARTAMENTOS_DB_PASSWORD=departamentos
# Contraseña de administración exigida por la imagen oficial de MySQL.
DEPARTAMENTOS_DB_ROOT_PASSWORD=departamentos_root
