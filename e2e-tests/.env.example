# Copia este archivo a e2e-tests/.env. No commitees el .env.
# ADMIN_* tiene que coincidir con la semilla del compose (AUTH_ADMIN_*).
# USER_PASSWORD es la clave que la suite establece en cada empleado nuevo.
# Debe cumplir la política del Reto 5: 8 caracteres, mayúscula, minúscula y dígito.

BASE_URL=http://localhost:8080
ADMIN_USUARIO=admin
ADMIN_PASSWORD=Admin1234!
USER_PASSWORD=Usuario123!

# 15 × 2000 ms = 30 s. La fase 6 mide la propagación real y deja estos valores
# con margen sobre el máximo observado. Ver README, sección «Calibración».
POLL_INTENTOS=15
POLL_INTERVALO_MS=2000
