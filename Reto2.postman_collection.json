{
	"info": {
		"name": "Reto 2 - Empleados + Departamentos",
		"description": "Colección de todo el sistema (Reto 2): departamentos-service (Go/MySQL) y empleados-service (Java/PostgreSQL), orquestados con el docker-compose.yml de la raíz del monorepo. Ejecutar las carpetas en orden: primero '1. Departamentos' (crea el departamento IT que usan las pruebas de empleados), luego '2. Empleados'. La carpeta '3. Resiliencia' requiere detener manualmente departamentos-service antes de correrla (ver su descripción) y volver a iniciarlo después.\n\nArrancar todo con: docker compose up --build (desde la raíz del repo).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "empleados_url", "value": "http://localhost:8080", "type": "string" },
		{ "key": "departamentos_url", "value": "http://localhost:8081", "type": "string" }
	],
	"item": [
		{
			"name": "0. Health",
			"item": [
				{
					"name": "Health departamentos-service (UP)",
					"request": { "method": "GET", "header": [], "url": "{{departamentos_url}}/health" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 200', () => pm.response.to.have.status(200));",
						"pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
					] } }]
				},
				{
					"name": "Health empleados-service (UP)",
					"request": { "method": "GET", "header": [], "url": "{{empleados_url}}/health" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 200', () => pm.response.to.have.status(200));",
						"pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
					] } }]
				}
			]
		},
		{
			"name": "1. Departamentos",
			"item": [
				{
					"name": "Crear departamento IT - éxito (201)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{departamentos_url}}/departamentos",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"IT\",\n  \"nombre\": \"Tecnología\",\n  \"descripcion\": \"Departamento de TI\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					},
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 201', () => pm.response.to.have.status(201));",
						"pm.test('Devuelve el departamento creado', () => pm.expect(pm.response.json().id).to.eql('IT'));"
					] } }]
				},
				{
					"name": "Consultar departamento IT (200)",
					"request": { "method": "GET", "header": [], "url": "{{departamentos_url}}/departamentos/IT" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 200', () => pm.response.to.have.status(200));",
						"pm.test('nombre correcto', () => pm.expect(pm.response.json().nombre).to.eql('Tecnología'));"
					] } }]
				},
				{
					"name": "Listar departamentos (200)",
					"request": { "method": "GET", "header": [], "url": "{{departamentos_url}}/departamentos" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 200', () => pm.response.to.have.status(200));",
						"pm.test('incluye IT', () => pm.expect(pm.response.json().map(d => d.id)).to.include('IT'));"
					] } }]
				},
				{
					"name": "Crear departamento IT duplicado (400)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{departamentos_url}}/departamentos",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"IT\",\n  \"nombre\": \"Otro nombre\",\n  \"descripcion\": \"x\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					},
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 400', () => pm.response.to.have.status(400));",
						"pm.test('Mensaje de duplicado', () => pm.expect(pm.response.json().mensaje).to.eql('ya existe un departamento registrado con ese id'));"
					] } }]
				},
				{
					"name": "Consultar departamento inexistente (404)",
					"request": { "method": "GET", "header": [], "url": "{{departamentos_url}}/departamentos/NO-EXISTE" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 404', () => pm.response.to.have.status(404));",
						"pm.test('Mensaje descriptivo', () => pm.expect(pm.response.json().mensaje).to.eql('el departamento con id NO-EXISTE no existe'));"
					] } }]
				}
			]
		},
