		{
			"name": "3. Resiliencia (manual)",
			"description": "Antes de correr el siguiente request: en una terminal, ejecuta `docker compose stop departamentos-service`. El request tarda unos segundos (timeout 3s x 4 intentos + backoff 1s→2s→4s) y debe responder 503, sin persistir el empleado. Al terminar, vuelve a levantar el servicio con `docker compose start departamentos-service` antes de seguir usando el resto de la colección.",
			"item": [
				{
					"name": "Registrar empleado con departamentos-service caído (503)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{empleados_url}}/empleados",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"E005\",\n  \"nombre\": \"Luis\",\n  \"apellido\": \"Ramírez\",\n  \"email\": \"luis@empresa.com\",\n  \"numeroEmpleado\": \"EMP-2026-005\",\n  \"cargo\": \"QA\",\n  \"area\": \"Tecnología\",\n  \"departamentoId\": \"IT\",\n  \"fechaIngreso\": \"2026-02-12\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					},
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 503 (requiere departamentos-service detenido)', () => pm.response.to.have.status(503));",
						"pm.test('Mensaje de servicio no disponible', () => pm.expect(pm.response.json().mensaje).to.eql('El servicio de departamentos no está disponible para validar el departamento'));"
					] } }]
				},
				{
					"name": "Confirmar que E005 no quedó persistido (404)",
					"request": { "method": "GET", "header": [], "url": "{{empleados_url}}/empleados/E005" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 404', () => pm.response.to.have.status(404));"
					] } }]
				}
			]
		}
