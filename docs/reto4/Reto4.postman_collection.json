                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const periodo = pm.response.json();",
                  "pm.test('PROGRAMADA', () => pm.expect(periodo.estado).to.eql('PROGRAMADA'));",
                  "pm.test('empleado E001', () => pm.expect(periodo.empleadoId).to.eql('E001'));",
                  "pm.test('fechas', () => {",
                  "    pm.expect(periodo.fechaInicio).to.eql('2027-03-15');",
                  "    pm.expect(periodo.fechaFin).to.eql('2027-03-30');",
                  "});",
