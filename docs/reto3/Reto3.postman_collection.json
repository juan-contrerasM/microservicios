						"pm.test('Gateway UP aunque departamentos este caido', () => pm.expect(pm.response.json().status).to.eql('UP'));"
					] } }]
				},
				{
					"name": "B1 STOP empleados — GET /empleados (503 Gateway)",
					"request": { "method": "GET", "header": [], "url": "{{gateway_url}}/empleados" },
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('Status 503', () => pm.response.to.have.status(503));",
						"pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/json/i));",
						"pm.test('identifica el servicio caido', () => pm.expect(pm.response.json().servicio).to.eql('empleados-service'));",
						"pm.test('mensaje descriptivo', () => pm.expect(pm.response.json().mensaje).to.eql('El servicio de empleados no está disponible'));",
						"pm.test('no es HTML de framework', () => pm.expect(pm.response.text()).to.not.match(/<html/i));"
					] } }]
				},
