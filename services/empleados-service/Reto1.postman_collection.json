{
	"info": {
		"name": "Reto1 - Servicio de Empleados",
		"description": "Colección para probar la API REST de empleados (registro y consulta). Ejecutar en orden con Docker Compose levantado (docker compose up --build) — la app queda en http://localhost:8080.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Registrar empleado - éxito",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"url": "{{base_url}}/empleados",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": \"E001\",\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"juan.perez@empresa.com\",\n  \"numeroEmpleado\": \"EMP-2026-001\",\n  \"cargo\": \"Desarrollador Senior\",\n  \"area\": \"Tecnología\",\n  \"departamentoId\": \"IT\",\n  \"fechaIngreso\": \"2026-02-10\",\n  \"estado\": \"ACTIVO\"\n}",
					"options": { "raw": { "language": "json" } }
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));",
							"pm.test('Devuelve el empleado creado', () => {",
							"    const body = pm.response.json();",
							"    pm.expect(body.id).to.eql('E001');",
							"    pm.expect(body.estado).to.eql('ACTIVO');",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "Registrar empleado - id duplicado (409)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"url": "{{base_url}}/empleados",
