// CI de empleados-service. El workspace del job es la raíz del monorepo.
// Decisiones: docs/reto7/PLAN-RETO7.md
pipeline {
  agent any
  options {
    skipStagesAfterUnstable()
  }
  environment {
    TESTCONTAINERS_RYUK_DISABLED = 'true'
    TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'git rev-parse HEAD'
      }
    }

    stage('Build') {
      agent {
        docker {
          image 'maven:3.9-eclipse-temurin-21'
          reuseNode true
          args "-u root --network ${env.DOCKER_NETWORK} --add-host=host.docker.internal:host-gateway -v /var/run/docker.sock:/var/run/docker.sock -v jenkins_m2:/var/maven/.m2"
        }
      }
      steps {
        dir('services/empleados-service') {
          sh 'mvn -Dmaven.repo.local=/var/maven/.m2 clean compile -DskipTests'
          sh 'chown -R "$(stat -c %u .):$(stat -c %g .)" .'
        }
      }
    }

    stage('Test') {
      agent {
        docker {
          image 'maven:3.9-eclipse-temurin-21'
          reuseNode true
          args "-u root --network ${env.DOCKER_NETWORK} --add-host=host.docker.internal:host-gateway -v /var/run/docker.sock:/var/run/docker.sock -v jenkins_m2:/var/maven/.m2"
        }
      }
      steps {
        dir('services/empleados-service') {
          sh 'mvn -Dmaven.repo.local=/var/maven/.m2 verify -Dmaven.test.failure.ignore=true'
          sh 'chown -R "$(stat -c %u .):$(stat -c %g .)" .'
        }
      }
      post {
        always {
          dir('services/empleados-service') {
            junit 'target/surefire-reports/*.xml, target/failsafe-reports/*.xml'
            recordCoverage tools: [[parser: 'JACOCO', pattern: 'target/site/jacoco/jacoco.xml']],
              sourceCodeRetention: 'EVERY_BUILD'
          }
        }
      }
    }

    stage('SonarQube') {
      steps {
        script {
          env.SONAR_TOKEN = readFile('/run/sonar-bootstrap/token').trim()
        }
        withSonarQubeEnv('sonarqube') {
          script {
            docker.image('maven:3.9-eclipse-temurin-21').inside("-u root --network ${env.DOCKER_NETWORK} --add-host=host.docker.internal:host-gateway -v /var/run/docker.sock:/var/run/docker.sock -v jenkins_m2:/var/maven/.m2") {
              dir('services/empleados-service') {
                sh '''
                  set +x
                  set -eu
                  mvn -Dmaven.repo.local=/var/maven/.m2 sonar:sonar -Dsonar.host.url=http://sonarqube:9000
                  chown -R "$(stat -c %u .):$(stat -c %g .)" .
                '''
              }
            }
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Package') {
      steps {
        dir('services/empleados-service') {
          sh '''
            set -eu
            docker build -t "micro/empleados-service:${BUILD_NUMBER}" -t micro/empleados-service:latest .
            docker image inspect "micro/empleados-service:${BUILD_NUMBER}"
          '''
        }
      }
    }

    stage('E2E Tests') {
      options {
        lock(resource: 'ecosistema-e2e')
      }
      steps {
        sh '''
          set +x
          set -eu
          rm -rf e2e-tests/reports
          export GATEWAY_PORT=18080
          export RABBITMQ_PORT=5673
          export RABBITMQ_MANAGEMENT_PORT=15673
          export MAILHOG_UI_PORT=18025
          # El contenedor de Node no hereda las globales de JCasC. Se copian aquí,
          # sin imprimirlas, para que la BDD las lea.
          if [ -z "${ADMIN_USUARIO:-}" ] || [ -z "${ADMIN_PASSWORD:-}" ] || [ -z "${USER_PASSWORD:-}" ]; then
            pid=$(ps -eo pid,args | awk '/jenkins[.]war/ && !/awk/ { print $1; exit }')
            while IFS= read -r -d '' item; do
              case "$item" in
                ADMIN_USUARIO=*|ADMIN_PASSWORD=*|USER_PASSWORD=*) export "$item" ;;
              esac
            done < "/proc/${pid}/environ"
          fi
          if [ -z "${ADMIN_USUARIO:-}" ] || [ -z "${ADMIN_PASSWORD:-}" ] || [ -z "${USER_PASSWORD:-}" ]; then
            echo "Faltan ADMIN_USUARIO, ADMIN_PASSWORD o USER_PASSWORD en Jenkins" >&2
            exit 1
          fi
          umask 077
          cat > e2e-tests/.ci-env <<EOF
ADMIN_USUARIO=${ADMIN_USUARIO}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
USER_PASSWORD=${USER_PASSWORD}
BASE_URL=http://host.docker.internal:18080
EOF
          # Jenkins y Sonar ya ocupan sus container_name y sus puertos.
          # Este proyecto solo levanta el sistema de negocio.
          docker compose --env-file /workspace/.env \
            -f docker-compose.yml -f jenkins/docker-compose.ci.yml \
            -p micro-ci up -d --build \
            api-gateway empleados-service departamentos-service \
            notificaciones-service perfiles-service vacaciones-service \
            auth-service mailhog message-broker
          chmod +x jenkins/wait-for-healthy.sh
          jenkins/wait-for-healthy.sh
        '''
        script {
          docker.image('node:22').inside('-u root --add-host=host.docker.internal:host-gateway -v jenkins_npm:/root/.npm') {
            dir('e2e-tests') {
              sh '''
                set +x
                set -eu
                npm ci
                set -a
                . ./.ci-env
                set +a
                npm test || true
                rm -f .ci-env
                chown -R "$(stat -c %u .):$(stat -c %g .)" .
              '''
            }
          }
        }
      }
      post {
        always {
          junit testResults: 'e2e-tests/reports/junit.xml', allowEmptyResults: false
          cucumber jsonReportDirectory: 'e2e-tests/reports',
            fileIncludePattern: '**/cucumber.json',
            buildStatus: 'UNSTABLE'
          publishHTML target: [
            reportDir: 'e2e-tests/reports',
            reportFiles: 'cucumber.html',
            reportName: 'Reporte BDD',
            keepAll: true,
            alwaysLinkToLastBuild: true
          ]
          sh '''
            rm -f e2e-tests/.ci-env
            docker compose --env-file /workspace/.env \
              -f docker-compose.yml -f jenkins/docker-compose.ci.yml \
              -p micro-ci logs --no-color > docker-logs.txt || true
            docker compose --env-file /workspace/.env \
              -f docker-compose.yml -f jenkins/docker-compose.ci.yml \
              -p micro-ci down -v || true
          '''
          archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true
        }
      }
    }
  }
}
