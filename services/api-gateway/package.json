{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway de aplicación (Reto 3). Node.js + Express + http-proxy-middleware. Tercer lenguaje del monorepo: no Spring Cloud Gateway.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import ./src/telemetria.js src/index.js",
    "openapi:export": "node scripts/exportar-openapi.js",
    "pretest": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/app.js --test-coverage-include=src/auth.js --test-coverage-include=src/circuit-breaker.js --test-coverage-include=src/config.js --test-coverage-include=src/errors.js --test-coverage-include=src/logger.js --test-coverage-include=src/metricas.js --test-coverage-include=src/proxy.js --test-coverage-include=src/swagger.js --test-coverage-lines=${COBERTURA_MINIMA:-70} --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info \"tests/*.test.js\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.2",
    "@opentelemetry/exporter-zipkin": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3",
    "swagger-ui-dist": "5.17.14",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "supertest": "^7.1.4"
  }
}
