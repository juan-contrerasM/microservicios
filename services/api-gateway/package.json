{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway de aplicación (Reto 3). Node.js + Express + http-proxy-middleware. Tercer lenguaje del monorepo: no Spring Cloud Gateway.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import ./src/telemetria.js src/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.2",
    "@opentelemetry/exporter-zipkin": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
