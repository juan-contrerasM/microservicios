{
  "name": "vacaciones-service",
  "version": "1.0.0",
  "private": true,
  "description": "Períodos de vacaciones. Node.js 22 + Express + PostgreSQL. Publica vacaciones.programadas.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import ./src/telemetria.js src/index.js",
    "openapi:export": "node scripts/exportar-openapi.js",
    "pretest:integration": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "pretest": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "test:integration": "node --test --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit-integracion.xml \"tests/integracion/*.test.js\"",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/index.js --test-coverage-exclude=src/telemetria.js --test-coverage-lines=${COBERTURA_MINIMA:-70} --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info \"tests/*.test.js\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.2",
    "@opentelemetry/exporter-zipkin": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "amqplib": "^0.10.5",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "yaml": "2.6.1"
  }
}
