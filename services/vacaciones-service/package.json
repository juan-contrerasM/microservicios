{
  "name": "vacaciones-service",
  "version": "1.0.0",
  "private": true,
  "description": "Períodos de vacaciones. Node.js 22 + Express + PostgreSQL. Publica vacaciones.programadas.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "pretest": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/validar.js --test-coverage-include=src/fechas.js --test-coverage-include=src/transiciones.js --test-coverage-include=src/servicio.js --test-coverage-lines=70 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info \"tests/*.test.js\""
  },
  "dependencies": {
    "amqplib": "^0.10.5",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1"
  }
}
